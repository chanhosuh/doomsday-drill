<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.doomsday-drill</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/git/doomsday-drill/.venv/bin/python</string>
    <string>-m</string>
    <string>doomsday_drill.watcher</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/example/git/doomsday-drill</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>StandardOutPath</key>
  <string>/tmp/com.example.doomsday-drill.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/com.example.doomsday-drill.err.log</string>
</dict>
</plist>
